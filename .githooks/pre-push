#!/bin/sh
# Commits that never passed commit-msg (fast-forward, pull, cherry-pick, --no-verify)
# are checked here, before anything is published.
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then range="$local_sha"; else range="$remote_sha..$local_sha"; fi
  node scripts/public-guard.mjs --commits "$range" --ref "$remote_ref" || status=1
done
exit $status
