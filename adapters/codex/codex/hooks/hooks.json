{
  "description": "smugan — passive quality gate (https://github.com/DenisCDev/smugan)",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"__HOOKS_DIR__/smugan-hook.mjs\" pre",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"__HOOKS_DIR__/smugan-hook.mjs\" post",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"__HOOKS_DIR__/smugan-hook.mjs\" stop",
            "timeout": 300
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"__HOOKS_DIR__/smugan-hook.mjs\" sessionend",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
