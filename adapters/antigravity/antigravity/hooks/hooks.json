{
  "smugan": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "^(write_to_file|create_file|edit_file|replace_file_content|multi_replace_file_content|apply_patch)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"__NODE__\" \"__HOOKS_DIR__/smugan-hook.mjs\" pre",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(write_to_file|create_file|edit_file|replace_file_content|multi_replace_file_content|apply_patch)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"__NODE__\" \"__HOOKS_DIR__/smugan-hook.mjs\" post",
            "timeout": 180
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"__NODE__\" \"__HOOKS_DIR__/smugan-hook.mjs\" stop",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
